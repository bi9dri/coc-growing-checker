{
  "name": "coc-growing-checker",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "vp check",
    "lint": "vp lint",
    "format": "vp fmt",
    "typecheck": "tsc --noEmit",
    "test": "vp test",
    "test:mutation": "mutator",
    "build": "vp build",
    "vrt": "pnpm run build && playwright test -c playwright.vrt.config.ts",
    "vrt:update": "pnpm run build && playwright test -c playwright.vrt.config.ts --update-snapshots",
    "deploy": "pnpm build && wrangler deploy",
    "generate:og": "node scripts/generate-og-image.mjs",
    "dev": "vp dev",
    "prepare": "vp config"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "bcdice": "4.10.0",
    "clsx": "2.1.1",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@mizchi/mutator": "0.4.5",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "happy-dom": "21.0.4",
    "oxc-transform-react": "0.158.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "4.162.0"
  },
  "packageManager": "pnpm@12.20.0"
}
