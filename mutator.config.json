{
  "$schema": "./node_modules/@mizchi/mutator/schema/mutator.config.schema.json",
  "vitestConfig": "vite.config.ts",
  "include": ["src/domain/**/*.ts"],
  "exclude": ["src/domain/**/*.test.ts", "src/domain/**/types.ts"],
